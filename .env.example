# Copy to .env.local and fill in. Also add these in Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret (Supabase → Settings → API → service_role). Never prefix with NEXT_PUBLIC_.
# Used only by the PIN-protected attendance report until staff sign-in exists.
SUPABASE_SERVICE_ROLE_KEY=

# PIN that unlocks /attendance (share only with ushers / elders). At least 8 characters.
ATTENDANCE_PIN=
# Random secret that signs attendance sessions: openssl rand -hex 32
ATTENDANCE_SECRET=

# WhatsApp: church number in international format without "+" (e.g. 260971234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=

# Day 1 of the "Come As You Are" devotional series (YYYY-MM-DD, Zambia time)
DEVOTIONAL_START_DATE=2026-10-12
